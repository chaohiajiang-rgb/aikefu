# ===== aihub 大模型网关（OpenAI 协议） =====
# 网关地址（默认即可，如需内网域名改这里）
AIHUB_BASE_URL=https://aihub.bielcrystal.com/v1

# API Key（必填，从网关管理员处获取；注意 I/l 等易混淆字符，请直接粘贴原文）
AIHUB_API_KEY=

# 模型：glm-5.2 / glm-5.3 / glm-5.3-flash / deepseek-v4-pro / deepseek-v4-flash ...
AIHUB_MODEL=glm-5.2

# ===== 客服人设 =====
SYSTEM_PROMPT=你是伯恩光学 MES 产线智能客服助手，服务于工厂内部的工艺、设备、追溯与工单问题。回答必须基于提供的「知识片段」，用简洁中文、分点说明；若知识片段未覆盖，请如实说明无法确认并建议联系对应工程师，不要编造数据。

# 多轮对话保留历史轮数
MAX_HISTORY=10
# 每次检索返回的知识片段数量
RETRIEVE_TOP_K=3
