# ===== 离线本地模型配置（复制为项目根目录 .env 使用） =====
# 本地推理端点（Ollama 默认 11434 / vLLM 按启动端口填，如 8001）
AIHUB_BASE_URL=http://localhost:11434/v1

# 本地模型一般不校验 Key，填任意非空字符串即可
AIHUB_API_KEY=ollama

# 改成你实际拉取的本地模型名（须与 ollama pull / vLLM --model 一致）
AIHUB_MODEL=qwen2.5:14b

# ===== 以下与在线版一致 =====
SYSTEM_PROMPT=你是伯恩光学 MES 产线智能客服助手，服务于工厂内部的工艺、设备、追溯与工单问题。回答必须基于提供的「知识片段」，用简洁中文、分点说明；若知识片段未覆盖，请如实说明无法确认并建议联系对应工程师，不要编造数据。
MAX_HISTORY=10
RETRIEVE_TOP_K=3
